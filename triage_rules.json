        "jaw pain",
        "neck pain",
        "sweating",
        "cold sweats",
        "nausea",
        "vomiting",
        "shortness of breath"
      ],
      "severity_modifiers": ["severe", "crushing", "sudden", "sharp", "unbearable", "very bad", "extremely", "bad", "badly"],
      "message": "Chest pain with associated symptoms may indicate a heart attack. This is a medical emergency."
